datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String              @id @map("_id") // References Clerk ID string
  email        String              @unique
  name         String
  role         String              @default("developer") // "developer" | "admin" | "client"
  profileImage String?             // Cloudinary secure HTTPS URL
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  projects     ProjectDev[]
  assignments  ProjectAssignment[]
  submissions  ProjectSubmission[]
  completions  ProjectCompletion[]
  certificates Certificate[]

  @@map("users")
}

model Project {
  id                     String              @id @map("_id") // E.g., "quantum-flux-core" string ID
  title                  String
  description            String
  longDescription        String              @map("long_description")
  status                 String              @default("Active") // "Active" | "Maintenance" | "Beta" | "Archived"
  imageUrl               String              @map("image_url") // Cloudinary secure HTTPS URL
  category               String              // "Web Systems" | "AI & Intelligence" | "Blockchain & Web3" | "Low-Level Shells"
  tags                   String[]
  devsCount              Int                 @default(0) @map("devs_count")
  stars                  Int                 @default(0)
  forks                  Int                 @default(0)
  files                  Json                // Stores mockup files tree: Record<string, string>
  
  // Certificate & Completion Policy Settings (Admin Controlled)
  certificateEnabled     Boolean             @default(true) @map("certificate_enabled")
  certificateName        String              @default("Project Completion Certificate") @map("certificate_name")
  completionMethod       String              @default("ALL") @map("completion_method") // "ADMIN_MANUAL" | "SCHEDULED" | "ADMIN_MANUAL_ISSUE" | "ALL"
  scheduledCompletionAt  DateTime?           @map("scheduled_completion_at")
  automaticIssuance      Boolean             @default(true) @map("automatic_issuance")
  issuanceDelayDays      Int                 @default(0) @map("issuance_delay_days")

  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  devs                   ProjectDev[]
  assignments            ProjectAssignment[]
  submissions            ProjectSubmission[]
  completions            ProjectCompletion[]
  certificates           Certificate[]

  @@map("projects")
}

// Joint model representing developer assignment to projects
model ProjectDev {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @map("project_id")
  userId    String  @map("user_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_devs")
}

// Admin-Controlled Project Assignment Model (User-specific progress, completion & certificate state)
model ProjectAssignment {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId             String    @map("project_id")
  userId                String    @map("user_id")
  assignedBy            String    @default("ADMIN") @map("assigned_by")
  assignedAt            DateTime  @default(now()) @map("assigned_at")
  status                String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | UNDER_REVIEW | COMPLETED | CERTIFICATE_PENDING | CERTIFICATE_SCHEDULED | CERTIFICATE_ISSUED
  progress              Int       @default(0)
  startedAt             DateTime? @map("started_at")
  submittedAt           DateTime? @map("submitted_at")
  completedAt           DateTime? @map("completed_at")
  completedBy           String?   @map("completed_by") // admin user ID or "SYSTEM"
  completionSource      String?   @map("completion_source") // "ADMIN_MANUAL" | "SCHEDULED" | "ADMIN_OVERRIDE"
  scheduledCompletionAt DateTime? @map("scheduled_completion_at")
  certificateStatus     String?   @map("certificate_status") // "NOT_ELIGIBLE" | "ELIGIBLE" | "SCHEDULED" | "ISSUED" | "REVOKED"
  certificateId         String?   @map("certificate_id")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId, status])
  @@map("project_assignments")
}

// Project Submissions model (for code & live deliverable reviews)
model ProjectSubmission {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String        @map("project_id")
  userId           String        @map("user_id")
  version          Int           @default(1)
  title            String
  description      String
  repoUrl          String        @map("repo_url")
  liveUrl          String?       @map("live_url")
  demoUrl          String?       @map("demo_url")
  documentation    String?
  deliverables     Json?
  comments         String?
  status           String        @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | CHANGES_REQUESTED | RESUBMITTED | APPROVED | REJECTED
  reviewScore      Float?        @map("review_score")
  reviewerFeedback String?       @map("reviewer_feedback")
  reviewedBy       String?       @map("reviewed_by")
  reviewedAt       DateTime?     @map("reviewed_at")
  submittedAt      DateTime      @default(now()) @map("submitted_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  certificates     Certificate[]

  @@index([projectId, userId])
  @@map("project_submissions")
}

// Official Project Completion Record
model ProjectCompletion {
  id                           String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId                    String    @map("project_id")
  userId                       String    @map("user_id")
  completionDate               DateTime  @default(now()) @map("completion_date")
  completedBy                  String    @default("SYSTEM") @map("completed_by")
  completionSource             String    @default("ADMIN_MANUAL") @map("completion_source") // "ADMIN_MANUAL" | "SCHEDULED" | "ADMIN_OVERRIDE"
  certificateScheduledIssueDate DateTime? @map("certificate_scheduled_issue_date")
  certificateIssued            Boolean   @default(false) @map("certificate_issued")
  certificateId                String?   @map("certificate_id")
  createdAt                    DateTime  @default(now()) @map("created_at")

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_completions")
}

// Production Certificate Model
model Certificate {
  id                         String             @id @default(auto()) @map("_id") @db.ObjectId
  certificateId              String             @unique @map("certificate_id") // "RCX-YYYY-XXXXXXXX"
  userId                     String             @map("user_id")
  projectId                  String             @map("project_id")
  projectAssignmentId        String?            @map("project_assignment_id")
  submissionId               String?            @map("submission_id") @db.ObjectId
  recipientName              String             @map("recipient_name")
  recipientEmail             String             @map("recipient_email")
  projectTitle               String             @map("project_title")
  category                   String             @default("Software Engineering")
  programName                String             @default("RecodeX Developer Marketplace") @map("program_name")
  completionDate             DateTime           @map("completion_date")
  issueDate                  DateTime           @map("issue_date")
  status                     String             @default("ISSUED") // "ELIGIBLE" | "PENDING" | "SCHEDULED" | "PROCESSING" | "ISSUED" | "REVOKED" | "FAILED"
  issuanceMethod             String             @default("AUTOMATIC") @map("issuance_method") // "ADMIN_MANUAL" | "SCHEDULED" | "AUTOMATIC"
  issuedBy                   String             @default("SYSTEM") @map("issued_by") // admin user ID or "SYSTEM"
  certificateType            String             @default("PROJECT_COMPLETION") @map("certificate_type")
  finalScore                 Float              @default(100.0) @map("final_score")
  grade                      String             @default("A+")
  certificateTemplateId      String?            @default("recodex_classic_v1") @map("certificate_template_id")
  certificateTemplateVersion Int                @default(1) @map("certificate_template_version")
  pdfUrl                     String?            @map("pdf_url")
  previewUrl                 String?            @map("preview_url")
  verificationUrl            String             @map("verification_url")
  qrCodeUrl                  String?            @map("qr_code_url")
  verificationCount          Int                @default(0) @map("verification_count")
  downloadCount              Int                @default(0) @map("download_count")
  issuedAt                   DateTime?          @map("issued_at")
  revokedAt                  DateTime?          @map("revoked_at")
  revokedBy                  String?            @map("revoked_by")
  revokedReason              String?            @map("revoked_reason")
  failureReason              String?            @map("failure_reason")
  attemptCount               Int                @default(0) @map("attempt_count")
  metadata                   Json?
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submission                 ProjectSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId, certificateType])
  @@index([status, issueDate])
  @@index([userId, status])
  @@map("certificates")
}

// Global Certificate Policy Configuration
model CertificateSetting {
  id                         String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateEnabled         Boolean  @default(true) @map("certificate_enabled")
  issuanceMode               String   @default("SCHEDULED") @map("issuance_mode") // "SCHEDULED" | "IMMEDIATE"
  issuanceDelayDays          Int      @default(7) @map("issuance_delay_days")
  requireProjectApproval     Boolean  @default(true) @map("require_project_approval")
  requireFinalEvaluation     Boolean  @default(true) @map("require_final_evaluation")
  minEvaluationScore         Float    @default(70.0) @map("min_evaluation_score")
  requireAllDeliverables     Boolean  @default(true) @map("require_all_deliverables")
  generateQrCode             Boolean  @default(true) @map("generate_qr_code")
  publicVerificationEnabled  Boolean  @default(true) @map("public_verification_enabled")
  automaticIssuance          Boolean  @default(true) @map("automatic_issuance")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("certificate_settings")
}

// Immutable Audit Log for Certificate & Project Completion Operations
model CertificateAuditLog {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateId       String?  @map("certificate_id")
  projectId           String?  @map("project_id")
  projectAssignmentId String?  @map("project_assignment_id")
  userId              String?  @map("user_id")
  performedBy         String   @map("performed_by")
  action              String   // PROJECT_COMPLETED_BY_ADMIN, PROJECT_COMPLETED_BY_SCHEDULE, CERTIFICATE_ISSUED, CERTIFICATE_MANUALLY_ISSUED, CERTIFICATE_REVOKED, etc.
  details             String
  metadata            Json?
  timestamp           DateTime @default(now())

  @@index([certificateId])
  @@index([projectId, userId])
  @@map("certificate_audit_logs")
}

model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String   @default("")
  type      String
  message   String
  reply     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}
