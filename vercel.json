{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{backend/node_modules/.prisma/client/**,backend/prisma/**,node_modules/.prisma/client/**,prisma/**,backend/src/config/mockProjects.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
